%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0fd4c3c83fae23b4cae61c12ce438472, type: 3}
  m_Name: Fanatic
  m_EditorClassIdentifier: 
  speakerName: Fanatic
  defaultPath:
    pathName: Introduction
    paragraphs:
    - It's all around us!!!
    - This mist...mist...mist...mist!
    - Can you believe it!
    emotions: 000000000100000005000000
  repeatedItemPath:
    pathName: Again...?
    paragraphs:
    - Oh joy.... {itemName}.... Again....  {itemGiven}
    emotions: 03000000
  paths:
  - pathName: Buy something!
    paragraphs:
    - Anything looking appetizing?
    emotions: 00000000
  - pathName: Want to buy this?
    paragraphs:
    - Your taste buds have landed on the {storeItemName}. Its yours for {storeItemValue}
      <color=#E0D38F>Mints</color> <sprite index=0>!  {dontfreezePlayer}
    emotions: 00000000
  - pathName: Sold!
    paragraphs:
    - I hope you get more use out of that thing than I did! {itemBought}  {dontfreezePlayer}
    emotions: 01000000
  - pathName: No Money
    paragraphs:
    - You are gonna need some more money before you can have a bite of that
    emotions: 02000000
  - pathName: No Space
    paragraphs:
    - Your stomach, or perhaps inventory, seems to full to buy this
    emotions: 05000000
  - pathName: Have bombs
    paragraphs:
    - I can see it! All over you!
    - The Mist's stain! You must cleanse yourself!
    - Place these in the water of the spring and let it purify you! {givePlayerItems}
    emotions: 050000000300000000000000
  - pathName: She wasnt the first
    paragraphs:
    - The lady.... She was not the first... {freezePlayer}
    - ...
    - AND SHE WON'T BE THE LAST!
    emotions: 020000000600000003000000
  - pathName: Giving trinket bug quest
    paragraphs:
    - I have had an epiphany!  {freezePlayer}
    - There lies secrets! Potential! Within the bugs!
    - You don't believe me?? No one believes me! I can prove it!
    - Bring me a handful of beetles. These old hands can't steady a net!
    emotions: 01000000050000000400000003000000
  - pathName: Giving trinket bug quest 2
    paragraphs:
    - Now that you have had a taste of this power, I bet you are looking for more,
      eh?  {freezePlayer}
    - Well, what are you waiting for?? Time to leave that wretched hoe behind and
      pick up that net son.
    - Time to get a catchin'!
    emotions: 040000000300000001000000
  - pathName: Giving trinket bug quest 3
    paragraphs:
    - What is this? You come seeking more..?  {freezePlayer}
    - We are almost at our limit lad... Any more power after this and our bodies
      will implode!
    - Bring me these last final specimins...
    emotions: 040000000500000000000000
  fillerPaths:
  - pathName: Mist Everywhere
    paragraphs:
    - There used to be a time when the horizon was clear as day.
    - Now you can't go ten FEET without it filling your eyes!
    emotions: 0100000003000000
  - pathName: Mistwalkers
    paragraphs:
    - Sometimes I can still hear those mistwalkers.
    - I can't sleep when I hear them.
    - It's been days without sleep.
    emotions: 000000000200000000000000
  - pathName: Cake
    paragraphs:
    - The Mist... it wont stop speaking to me!
    - It's in the air... the water... the food!
    - In that foresaken cake!
    emotions: 030000000000000005000000
  - pathName: Look at this
    paragraphs:
    - Do you see what I see!?!
    - It's right there!!
    - Deep within... It watches us. Talks to us!
    - And no one can hear a thing!
    emotions: 04000000050000000000000003000000
  - pathName: Tainted Water
    paragraphs:
    - DON'T GO INTO THE WATER!
    - It's tainted! TAINTED!
    - It's all tainted and impure!
    emotions: 050000000500000000000000
  - pathName: Day or Night
    paragraphs:
    - I don't know which is worse!
    - The monsters that lumber around at dusk...
    - Or the ones that tread the streets at dawn!
    emotions: 040000000000000002000000
  - pathName: Endless Running
    paragraphs:
    - Endlessly running in circles...
    - Around and around and around and around and around and around and around and
      around and around and around and around and around and around.
    - Just to end back up here!
    emotions: 020000000000000001000000
  - pathName: Mist Servants
    paragraphs:
    - You are all mindless servants to the Fog!
    - Begging and scrounging around, to get even a morsel of what it offers you from
      the ground!
    - None of you are different than what shambles beyond the walls!
    emotions: 030000000000000003000000
  - pathName: Come Here Often
    paragraphs:
    - Come here often?
    emotions: 04000000
  - pathName: Flying Hares
    paragraphs:
    - The hares!! I have seen them fly!
    - You gotta believe me!
    emotions: 0500000003000000
  - pathName: Tea Party
    paragraphs:
    - Oh, you are just in time!
    - Me and the bugs were about to throw a tea party.
    - Care to join??
    emotions: 010000000000000004000000
  - pathName: Reflection
    paragraphs:
    - When you gaze into the water, what is it that glares back at you?
    - I pray you don't see what I am seeing!
    emotions: 0400000002000000
  - pathName: Foreshadowing
    paragraphs:
    - I have seen our future!
    - Our homes ablaze! The fields littered with corpses and dust!
    - It is inevitable! The golden light will be our undoing!
    emotions: 050000000200000003000000
  questPaths:
  - pathName: Giving trinket bug quest
    paragraphs:
    - THEY ARE PUTTING SOMETHING IN THE BUGS!  {freezePlayer}
    - There lies secrets! Magic! Within the bugs!
    - You don't believe me?? No one believes me! But I can prove it!
    - Bring me a handful of beetles. These old hands can't steady a net!
    emotions: 01000000050000000400000003000000
  - pathName: Giving trinket bug quest 2
    paragraphs:
    - Now that you have had a taste of this power, I bet you are looking for more,
      eh?  {freezePlayer}
    - Well, what are you waiting for?? Time to leave that wretched hoe behind and
      pick up that net son.
    - Time to get a catchin'!
    emotions: 040000000300000001000000
  - pathName: Giving trinket bug quest 3
    paragraphs:
    - What is this? You come seeking more..?  {freezePlayer}
    - We are almost at our limit lad... Any more power after this and our bodies
      will implode!
    - Bring me these last final specimins...
    emotions: 040000000500000000000000
  itemRecievedPaths:
  - pathName: Go Sell it instead
    paragraphs:
    - I don't have much use for something like that.
    - If you are looking to sell your stuff, I bet that weird wagon fellow will purchase
      it.
    emotions: 0200000000000000
  itemSpecificRemarks:
  - pathName: Go Sell it instead
    paragraphs:
    - GET IT AWAY FROM ME.
    emotions: 03000000
  - pathName: Scroll
    paragraphs:
    - THE LIGHT! ITS BLINDING! THOSE WHO CAME BEFORE WILL FIND US!
    - DO YOU WANT EVEN MORE EYES ON THIS TOWN??
    emotions: 0300000005000000
  friendshipPath1: []
  friendshipPath2: []
  friendshipPath3: []
  alreadySpoken:
  - pathName: ...
    paragraphs:
    - '...

'
    emotions: 06000000
  branchingPaths: []
  questCompletePaths:
  - pathName: Default Quest Complete
    paragraphs:
    - Thank you for completing my quest!
    emotions: 01000000
  - pathName: Completed Trinket Bug Quest 1
    paragraphs:
    - Mmmm yesss... Yes these will do... {freezePlayer}
    - I have been blessed with knowledge that I will bestow upon you...
    - Go on! Wear this trinket I have just created... These trinkets grant otherworldly
      powers you cannot comprehend! {givePlayerItems}
    - With my creations, we will become gods!
    - Leave me be now! I must ponder more...
    - Whats that...? You say you have no place to wear it!
    - Bah! Enough of such nonsense! Here, keep it in one of these! Now begone with
      you!
    emotions: 01000000000000000300000001000000030000000400000003000000
  - pathName: Completed Trinket Bug Quest 2
    paragraphs:
    - Very good! {freezePlayer}
    - Here is your reward, as promised.
    emotions: 0100000000000000
  dailyQuestPaths:
  - pathName: Daily Quest
    paragraphs:
    - Perfect timing! I was hoping you could help me out with something. {freezePlayer}
    emotions: 01000000
  itemPaths:
  - pathName: Generic Bugs
    dialoguePath:
      pathName: Bugs
      paragraphs:
      - Oh yes, a fine specimin indeed.
      - I can feel the power ROARING from within.
      emotions: 0100000005000000
    validItems: []
    pathType: 1
  - pathName: Generic Consumable
    dialoguePath:
      pathName: Consumable
      paragraphs:
      - You can't fool me!
      - Our food supply is TAINTED from that wretched land! I take pride in my wellbeing.
      emotions: 0300000003000000
    validItems: []
    pathType: 2
  - pathName: Don't use as TP
    dialoguePath:
      pathName: 
      paragraphs:
      - Whatever you do, do NOT use it as toilet paper!
      emotions: 03000000
    validItems:
    - {fileID: 11400000, guid: 3249d94b36f7b7343b98bd0653499271, type: 2}
    pathType: 0
  - pathName: LoamBeetle
    dialoguePath:
      pathName: 
      paragraphs:
      - Oh that one's a chatterbox right there. Always something to say.
      emotions: 00000000
    validItems:
    - {fileID: 11400000, guid: c9af372d6ca36fd46b681856e9182698, type: 2}
    pathType: 0
  - pathName: Reed Nibbles
    dialoguePath:
      pathName: 
      paragraphs:
      - Aha, Fiddlebert! How the heck are ya?
      emotions: 01000000
    validItems:
    - {fileID: 11400000, guid: df4c35edce1e14a4faefdf1f56156a90, type: 2}
    pathType: 0
