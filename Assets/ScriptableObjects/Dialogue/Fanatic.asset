%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0fd4c3c83fae23b4cae61c12ce438472, type: 3}
  m_Name: Fanatic
  m_EditorClassIdentifier: 
  speakerName: Fanatic
  defaultPath:
    pathName: Introduction
    paragraphs:
    - It's all around us!!!
    - This mist...mist...mist...mist!
    - Can you believe it!
    emotions: 000000000100000005000000
  questCompletePath:
    pathName: Thanks for completing quest
    paragraphs:
    - Thank you for completing my quest!
    emotions: 06000000
  repeatedItemPath:
    pathName: Again...?
    paragraphs:
    - Oh joy.... {itemName}.... Again....  {itemGiven}
    emotions: 03000000
  paths:
  - pathName: Buy something!
    paragraphs:
    - Anything looking appetizing?
    emotions: 00000000
  - pathName: Want to buy this?
    paragraphs:
    - Your taste buds have landed on the {storeItemName}. Its yours for {storeItemValue}
      <color=#E0D38F>Mints</color> <sprite index=0>!
    emotions: 00000000
  - pathName: Sold!
    paragraphs:
    - I hope you get more use out of that thing than I did! {itemBought}
    emotions: 01000000
  - pathName: No Money
    paragraphs:
    - You are gonna need some more money before you can have a bite of that
    emotions: 02000000
  - pathName: No Space
    paragraphs:
    - Your stomach, or perhaps inventory, seems to full to buy this
    emotions: 05000000
  fillerPaths:
  - pathName: Mist Everywhere
    paragraphs:
    - Thre used to be a time when the horizon was clear as day.
    - Now you cant go ten FEET without it filling your eyes!
    emotions: 0100000003000000
  - pathName: Mistwalkers
    paragraphs:
    - Sometimes I can still hear those mistwalkers.
    - I can't sleep when I hear them.
    - It's been days without sleep.
    emotions: 000000000200000000000000
  - pathName: Cake
    paragraphs:
    - The Mist... it wont stop speaking to me!
    - It's in the air... the water... the food!
    - In that foresaken cake!
    emotions: 030000000000000005000000
  questPaths: []
  itemRecievedPaths:
  - pathName: Go Sell it instead
    paragraphs:
    - I don't have much use for something like that.
    - If you are looking to sell your stuff, I bet that weird wagon fellow will purchase
      it.
    emotions: 0200000000000000
  itemSpecificRemarks:
  - pathName: Go Sell it instead
    paragraphs:
    - GET IT AWAY FROM ME.
    emotions: 03000000
  friendshipPath1: []
  friendshipPath2: []
  friendshipPath3: []
