%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0fd4c3c83fae23b4cae61c12ce438472, type: 3}
  m_Name: Rascal
  m_EditorClassIdentifier: 
  speakerName: Rascal
  defaultPath:
    pathName: Introduction
    paragraphs:
    - Ahh! Everyone, come look!
    - One of those Mist Walkers got into town!
    - .... Oh wait.... False alarm...
    - Its just that new plant guy.
    emotions: 05000000060000000000000006000000
  repeatedItemPath:
    pathName: 
    paragraphs:
    - Bleh! Something NEW please?
    emotions: 03000000
  paths:
  - pathName: Buy something!
    paragraphs:
    - Hey! Come by my tras- I mean treasure I found!
    emotions: 01000000
  - pathName: Want to buy this?
    paragraphs:
    - Oh I know you are interested in the {storeItemName}. For such a low price,
      how could you NOT say yes?! {dontfreezePlayer}
    emotions: 01000000
  - pathName: Sold!
    paragraphs:
    - This store stuff is such easy work!! {itemBought} {dontfreezePlayer}
    emotions: 01000000
  - pathName: No Money
    paragraphs:
    - No Stealing! I found this stuff first!
    emotions: 03000000
  - pathName: No Space
    paragraphs:
    - You should talk to the town fanatic. You both LOVE hoarding useless junk!
    emotions: 05000000
  fillerPaths:
  - pathName: Filler1
    paragraphs:
    - You look pretty old.
    emotions: 03000000
  - pathName: Filler2
    paragraphs:
    - You are from the farm?
    - Ha, I can tell.
    emotions: 0000000001000000
  - pathName: Filler3
    paragraphs:
    - Everyone in this town is always "<color=#E0D38F>Mints</color> <sprite index=0>
      this and <color=#E0D38F>Mints</color> <sprite index=0> that.
    - Is no one going to mention the freak in the wagon handing them out?
    emotions: 0300000002000000
  - pathName: Filler4
    paragraphs:
    - I've always wanted to see what that hooded weirdo keeps in his wagon, but I
      can never get the drop on him.
    - He is always in there... Always watching...
    - ...
    - What a bore!
    emotions: 00000000040000000600000001000000
  - pathName: Scrounging
    paragraphs:
    - It's amazing the things you can find by just walking around!
    - Gramps always tells me not to wander near the mist, but thats where the best
      stuff is!
    - I bet there are loads of treasures farther in. Wagon creep would know!
    emotions: 010000000300000000000000
  - pathName: Crop Talk
    paragraphs:
    - Don't you have some crops to talk to?
    emotions: 00000000
  - pathName: BearTrap
    paragraphs:
    - Don't you have some beartraps to step on?
    emotions: 00000000
  - pathName: Big Bugs
    paragraphs:
    - Its no fair! Pops won't let me go outside the town walls.
    - But I have seen the giant bugs outside! I wanna catch the big bugs!
    - The little ones have become too easy...
    emotions: 020000000500000003000000
  - pathName: Prank
    paragraphs:
    - I played such a great prank on the plant girl the other day!
    - I gathered a giant ball of green goop I found out by one of the walls the other
      day, and threw it on one of her seed pouches!
    - The look on her face was pure gold!
    emotions: 010000000000000001000000
  - pathName: Fire Bugs
    paragraphs:
    - Have you seen the red fire bugs at night?
    - Those are my favorite to catch! Make for good hand warmers.
    - Pops never lets me play with them though...
    emotions: 040000000100000002000000
  - pathName: New Friend
    paragraphs:
    - Have you ran into my new friend?
    - He is a Ferrat! As I was collecting Timber Ear off the floor, the little guy
      came up to me!
    - It was so cool! I wonder what he is up to right now?
    emotions: 040000000100000004000000
  - pathName: Town Cat
    paragraphs:
    - Have you seen our town cat yet?
    - She makes for the best bug catching partner!
    emotions: 0400000001000000
  - pathName: Candy
    paragraphs:
    - Pops said if I stay out of trouble, I will get hard candy for desert today.
    - I prefer to have both.
    emotions: 0000000001000000
  questPaths:
  - pathName: Empty
    paragraphs: []
    emotions: 
  - pathName: Food For Thought
    paragraphs:
    - Hey you! New guy! {freezePlayer}
    - You see that giant door in the graveyard? Rumor says there lies some huuuuuge
      secrets in there...
    - I bet you want to know how to open it!
    - Well, I MAY know where a key is... But I am just soooo hungry, I can barely
      remember...
    - Maybe a Pale Carrot would jog my memory...
    emotions: 0500000001000000000000000200000000000000
  - pathName: Inform of Key
    paragraphs:
    - Now we are talking! {itemGiven} {freezePlayer}
    - Alright, I HEARD there lies the key to the catacombs across the bridge.
    - Talk to that old wood guy. I'm sure he can clear that big tree in front of
      it.
    emotions: 010000000500000000000000
  - pathName: Lost My Net
    paragraphs:
    - Oh farmer guy, we have much more important things to be concerned over than
      some lousey carrots! {freezePlayer}
    - My bug net is missing! You just gotta help me find it!
    - ... Whats that look for?? Who do you think keeps our streets clean?!
    emotions: 050000000500000003000000
  - pathName: You Found My Net
    paragraphs:
    - Oh hey, you found my net. {freezePlayer}
    - Thing is, I got bored and made a new one. With reinforced Gloomstalk netting!
    - I don't need that old one anymore, you can have it.
    emotions: 000000000200000000000000
  itemRecievedPaths:
  - pathName: Go Sell that
    paragraphs:
    - Hey, you should give that to me instead of that creep in the wagon. I'm famished!
    emotions: 01000000
  - pathName: Thanks For Item!
    paragraphs:
    - Oh man, I was starving! {itemGiven}
    - Thanks, geezer!
    emotions: 0100000001000000
  - pathName: Im Full
    paragraphs:
    - Chill gramps, I still ain't done with the last thing you brought me!
    emotions: 05000000
  itemSpecificRemarks:
  - pathName: So What?
    paragraphs:
    - Um yea, I actually... Don't care.
    emotions: 03000000
  - pathName: Key Shown
    paragraphs:
    - Wait, you actually found a key there??
    - I mean, of course you found the key!
    - Go open the door by the graveyard. At least, I think thats where it goes.
    emotions: 050000000100000000000000
  - pathName: Scroll
    paragraphs:
    - Sorry gramps! I grew out of coloring books last year.
    emotions: 01000000
  - pathName: ScuttleGrub
    paragraphs:
    - Haha, look how squishy it is!
    emotions: 01000000
  friendshipPath1: []
  friendshipPath2: []
  friendshipPath3: []
  alreadySpoken:
  - pathName: ...
    paragraphs:
    - '...

'
    emotions: 06000000
  branchingPaths: []
  questCompletePaths:
  - pathName: Default Quest Complete
    paragraphs:
    - Thank you for completing my quest!
    emotions: 01000000
  dailyQuestPaths:
  - pathName: Daily Quest
    paragraphs:
    - Perfect timing! I was hoping you could help me out with something. {freezePlayer}
    emotions: 01000000
  itemPaths:
  - pathName: Generic Bugs
    dialoguePath:
      pathName: Bugs
      paragraphs:
      - Woah, so cool!
      - If only they were bigger... And on fire... And armed to the teeth with spears
        and pitchforks!
      emotions: 0100000005000000
    validItems: []
    pathType: 1
  - pathName: Generic Consumable
    dialoguePath:
      pathName: Consumable
      paragraphs:
      - Mmmmm, that sure does look tasty...
      - Cmon on green hands, you don't REALLY need those mints. Just hand it to me
        instead!
      emotions: 0100000005000000
    validItems: []
    pathType: 2
  - pathName: Put it under a chair
    dialoguePath:
      pathName: 
      paragraphs:
      - Have you tried putting that under someone's chair?
      - Highly recommend.
      emotions: 0400000001000000
    validItems:
    - {fileID: 11400000, guid: 9e83a3613304b99499152a63bd0e24cf, type: 2}
    - {fileID: 11400000, guid: 9e015e85091984b498110879ce31527c, type: 2}
    - {fileID: 11400000, guid: ad3821a813642114d9979d54224f657c, type: 2}
    - {fileID: 11400000, guid: 37a01ac4a714d134b8a2714e8d476a1f, type: 2}
    - {fileID: 11400000, guid: 399f6cecaa2990448994f3ec12b230da, type: 2}
    pathType: 0
  - pathName: Growing Ice
    dialoguePath:
      pathName: 
      paragraphs:
      - So what.... Your growing ice now?
      emotions: 04000000
    validItems:
    - {fileID: 11400000, guid: 7e1f78f7555b6ca408e04d4318a79a5b, type: 2}
    pathType: 0
  - pathName: Feeding pets
    dialoguePath:
      pathName: 
      paragraphs:
      - I used to have this pet pig that would LOVE to eat this stuff.
      - I haven't seen him in awhile though... I'm sure he is alright!
      - As long as that Butcher didn't get to him that is.
      emotions: 000000000000000002000000
    validItems:
    - {fileID: 11400000, guid: 5b59cea4bd1755040bd8b85dc8ce8116, type: 2}
    - {fileID: 11400000, guid: 74995d551757dbb4589b75d96c29bff1, type: 2}
    - {fileID: 11400000, guid: d403813e08bd09d4eb10e59186336d62, type: 2}
    pathType: 0
