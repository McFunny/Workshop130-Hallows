%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0fd4c3c83fae23b4cae61c12ce438472, type: 3}
  m_Name: TavernKeep
  m_EditorClassIdentifier: 
  speakerName: TavernKeep
  defaultPath:
    pathName: Introduction
    paragraphs:
    - It's always good to see new faces here.
    - So how has that new farm been treating you?
    - Well if you want some extra tasks, be sure to come talk to me.
    emotions: 010000000100000000000000
  repeatedItemPath:
    pathName: 
    paragraphs: []
    emotions: 
  paths:
  - pathName: Buy something!
    paragraphs:
    - Anything handy?
    emotions: 00000000
  - pathName: Want to buy this?
    paragraphs:
    - I see you got your eye on the {storeItemName}. It'll cost you {storeItemValue}
      <color=#E0D38F>Mints</color> <sprite index=0>!
    emotions: 00000000
  - pathName: Sold!
    paragraphs:
    - ... {itemBought}
    emotions: 01000000
  - pathName: No Money
    paragraphs:
    - Come back with some more money and I can sell this to you!
    emotions: 02000000
  - pathName: No Space
    paragraphs:
    - I don't think you would be able to carry this.
    emotions: 05000000
  fillerPaths:
  - pathName: Question
    paragraphs:
    - Hows the farm going?
    emotions: 00000000
  - pathName: Merchant
    paragraphs:
    - That guy in the wagon never brings me more drinks to sell!
    emotions: 03000000
  - pathName: Irregulars
    paragraphs:
    - It seems like everyday, I get the same people walkin' in here.
    - I like to call them "Irregulars". Haha!
    emotions: 0000000001000000
  - pathName: People Aren't the same
    paragraphs:
    - These people aren't the same as how they were.
    - Not that I can really remember HOW they were before...
    - Call it a hunch.
    emotions: 020000000000000000000000
  - pathName: Fermented Gloomstalk
    paragraphs:
    - The drink variety has been lacking, to say the least.
    - You can only ferment Gloomstalk so many times before it starts to get old.
    - Not that it really tasted good to begin with.
    emotions: 020000000000000001000000
  - pathName: Don't trust the food
    paragraphs:
    - I don't exactly trust the food we have around here, but these past years haven't
      given me the luxury to be picky.
    - Most of the stuff sold here just comes from that merchant across town anyways.
    - And... well.. I'm not dead yet!
    emotions: 030000000000000001000000
  - pathName: Spinning Hog
    paragraphs:
    - You see that spitted beast in the back?
    - Butcher nabbed it for us, said she found it ensnared in one of her traps outside
      the gate.
    - I have been letting it simmer for awhile now, to get it juuuuuust right.
    - Gotta make sure I don't forget to take it out. Can't have it sittin' there
      too long!
    emotions: 04000000000000000000000001000000
  questPaths:
  - pathName: Got a job for ya
    paragraphs:
    - Looking for some extra work?
    - I have been tipped off to an individual needing some assistance. I'll give
      you the details on this note.
    emotions: 0400000000000000
  itemRecievedPaths:
  - pathName: Go Sell it instead
    paragraphs:
    - I don't have much use for something like that.
    - If you are looking to sell your stuff, I bet that weird wagon fellow will purchase
      it.
    emotions: 0200000000000000
  itemSpecificRemarks:
  - pathName: Go Sell it instead
    paragraphs:
    - I'm not looking to purchase anything, sorry.
    emotions: 02000000
  friendshipPath1: []
  friendshipPath2: []
  friendshipPath3: []
  alreadySpoken:
  - pathName: ...
    paragraphs:
    - '...

'
    emotions: 06000000
  branchingPaths: []
  questCompletePaths:
  - pathName: Default Quest Complete
    paragraphs:
    - Thank you for completing my quest!
    emotions: 01000000
  dailyQuestPaths:
  - pathName: Daily Quest
    paragraphs:
    - Perfect timing! I was hoping you could help me out with something. {freezePlayer}
    emotions: 01000000
