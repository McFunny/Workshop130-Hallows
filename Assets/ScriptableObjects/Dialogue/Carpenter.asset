  speakerName: Carpenter
  defaultPath:
    pathName: Introduction
    paragraphs:
    - New face... you live over in that run down cabin?
    - It's a sore on the eyes. Maybe we can fix that.
    - My wide assortment of vanity is sure to spruce up that dingy adobe.
    emotions: 000000000300000001000000
  questCompletePath:
    pathName: Thanks for completing quest
    paragraphs:
    - Thank you for completing my quest!
    emotions: 06000000
  repeatedItemPath:
    pathName: Again...?
    paragraphs:
    - Oh joy.... {itemName}.... Again....  {itemGiven}
    emotions: 03000000
  paths:
  - pathName: Buy something!
    paragraphs:
    - Anything looking appetizing?
    emotions: 00000000
  - pathName: Want to buy this?
    paragraphs:
    - Your taste buds have landed on the {storeItemName}. Its yours for {storeItemValue}
      <color=#E0D38F>Mints</color> <sprite index=0>!
    emotions: 00000000
  - pathName: Sold!
    paragraphs:
    - Need anything else? {itemBought}
    emotions: 01000000
  - pathName: No Money
    paragraphs:
    - You are gonna need some more money before you can have a bite of that
    emotions: 02000000
  - pathName: No Space
    paragraphs:
    - Your stomach, or perhaps inventory, seems to full to buy this
    emotions: 05000000
  fillerPaths:
