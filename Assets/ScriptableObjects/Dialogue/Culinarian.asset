%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0fd4c3c83fae23b4cae61c12ce438472, type: 3}
  m_Name: Culinarian
  m_EditorClassIdentifier: 
  speakerName: Culinarian
  defaultPath:
    pathName: Introduction
    paragraphs:
    - Hey you are new around here!
    - Hopefully I'll be using your crops to make some great food!
    - Come by my shop and try the cuisine of Veilwood!
    emotions: 000000000000000001000000
  repeatedItemPath:
    pathName: Again...?
    paragraphs:
    - Oh joy.... {itemName}.... Again....  {itemGiven}
    emotions: 03000000
  paths:
  - pathName: Buy something!
    paragraphs:
    - Anything looking appetizing?
    emotions: 00000000
  - pathName: Want to buy this?
    paragraphs:
    - Your taste buds have landed on the {storeItemName}. Its yours for {storeItemValue}
      <color=#E0D38F>Mints</color> <sprite index=0>! {dontfreezePlayer}
    emotions: 00000000
  - pathName: Sold!
    paragraphs:
    - Thank you for your patronage. {itemBought} {dontfreezePlayer}
    emotions: 01000000
  - pathName: No Money
    paragraphs:
    - You are gonna need some more money before you can have a bite of that
    emotions: 02000000
  - pathName: No Space
    paragraphs:
    - Your stomach, or perhaps inventory, seems too full to buy this.
    emotions: 05000000
  - pathName: Want To Trade for this?
    paragraphs:
    - One {storeItemName} coming right up! I just need a few ingredients first. {dontfreezePlayer}
    emotions: 01000000
  - pathName: Not Enough Items
    paragraphs:
    - I cannot cook without proper ingredients!
    emotions: 03000000
  fillerPaths:
  - pathName: Gloomstalk Bread
    paragraphs:
    - Can you believe that Carpenter? He makes barricades out of Gloomstalk!
    - Using food as a defense measure? Preposterous! How absurd!
    - You don't see me making forts out of carrots and tubers!
    emotions: 030000000500000005000000
  - pathName: Mist food
    paragraphs:
    - Some people have told me food tasted better before the mist showed up.
    - I think they just haven't tried my cooking!
    emotions: 0000000001000000
  - pathName: Come to my store
    paragraphs:
    - Hey come check out my shop. I got some fresh ingredients from that wagon guy!
    emotions: 01000000
  - pathName: Baked Terratuber
    paragraphs:
    - The baked terratuber is one of my favorite things to make.
    - It's just so simple!
    emotions: 0000000001000000
  - pathName: Spring Roll
    paragraphs:
    - I can make even the simplest of things delicious!
    - Even the otherwise inedible!
    - Care for some Spring Rolls?
    emotions: 010000000000000004000000
  questPaths:
  - pathName: CrockPot Quest
    paragraphs:
    - Did you just give that boy a carrot... uncooked?!
    - We are way beyond the Stone Age, Mr.Farmer. We have methods to ensure our food
      does not taste like the dirt it comes from!
    - Well, since we are handing out food to just about everyone now, how about you
      fetch me some fresh ingredients?
    - You bring me ingredients to my booth, and in exchange, I equip you with the
      tools to properly prepare your food.
    emotions: 05000000030000000400000000000000
  itemRecievedPaths:
  - pathName: Go Sell it instead
    paragraphs:
    - I don't have much use for something like that.
    - If you are looking to sell your stuff, I bet that weird wagon fellow will purchase
      it.
    emotions: 0200000000000000
  itemSpecificRemarks:
  - pathName: Go Sell it instead
    paragraphs:
    - I don't have much use for something like that.
    - If you are looking to sell your stuff, I bet that weird wagon fellow will purchase
      it.
    emotions: 0200000000000000
  - pathName: Scroll
    paragraphs:
    - Whats this now? A recipe of sorts??
    emotions: 04000000
  - pathName: Ruined Food
    paragraphs:
    - Oh, oh my... That appears to be gore of my favorite comfort ingredients...
    - Remove this from my sight at once!
    emotions: 0500000003000000
  friendshipPath1: []
  friendshipPath2: []
  friendshipPath3: []
  alreadySpoken:
  - pathName: ...
    paragraphs:
    - '...

'
    emotions: 06000000
  branchingPaths: []
  questCompletePaths:
  - pathName: Default Quest Complete
    paragraphs:
    - Thank you for completing my quest!
    emotions: 01000000
  - pathName: Crockpot Quest Complete
    paragraphs:
    - Splendid Mr.Farmhand. I hope now your eyes have been opened to the wonderful
      world of the culinary arts!
    - Now that you have seen my work, I am going to provide you with your very own
      cooking apparatus!
    - Oh, enough with that look! It's easy!
    - Just throw four ingredients of your choice, fill up the container with oil,
      and set the base aflame.
    emotions: 01000000010000000300000000000000
  dailyQuestPaths:
  - pathName: Daily Quest
    paragraphs:
    - Exquisite! Mr.Farmhand, I am in need of some quality ingredients!
    - Trust that I will pay more handsomely than whatever that figure in the wagon
      is offering you.
    emotions: 0100000003000000
