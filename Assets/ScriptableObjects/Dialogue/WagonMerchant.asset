%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0fd4c3c83fae23b4cae61c12ce438472, type: 3}
  m_Name: WagonMerchant
  m_EditorClassIdentifier: 
  speakerName: Mist Merchant
  defaultPath:
    pathName: Selling Something?
    paragraphs:
    - Got something to sell?
    - Show me.
    emotions: 0000000003000000
  repeatedItemPath:
    pathName: 
    paragraphs: []
    emotions: 
  paths:
  - pathName: Want me to buy this?
    paragraphs:
    - 'For that {itemName} I can offer <color=#E0D38F> {itemValue} Mints</color>
      <sprite index=0>.

      Do we have a deal? {dontfreezePlayer}'
    emotions: 00000000
  - pathName: Will Not Buy
    paragraphs:
    - I have no need for that. {dontfreezePlayer}
    emotions: 03000000
  - pathName: Sold!
    paragraphs:
    - Pleasure doing business. {itemSold} {dontfreezePlayer}
    emotions: 01000000
  - pathName: Want me to buy all of those?
    paragraphs:
    - 'For all of those? I can offer <color=#E0D38F> {itemTotalValue} Mints</color>
      <sprite index=0>.

      What do you say? {dontfreezePlayer}'
    emotions: 00000000
  - pathName: Do you want to buy?
    paragraphs:
    - I see the {storeItemName} caught your eye. Care to buy for <color=#E0D38F>
      {storeItemValue} Mints </color> <sprite index=0>? {dontfreezePlayer}
    emotions: 00000000
  - pathName: Here you go!
    paragraphs:
    - Sold! {itemBought} {dontfreezePlayer}
    emotions: 01000000
  - pathName: Poor
    paragraphs:
    - Get some more money first.
    emotions: 03000000
  - pathName: No Space
    paragraphs:
    - This transaction is encumbered by your lack of organization. I will be waiting
      here until you make space.
    emotions: 03000000
  - pathName: Wilderness worthy
    paragraphs:
    - I have been watching you for some time now. {freezePlayer}
    - You seem capable. Perhaps you have some more untapped worth.
    - I will now take you on expeditions beyond the fog. There you will find a variety
      of unique seeds and lost artifacts.
    - There will also be great danger. Plan accordingly.
    - In return, I expect a great bounty. Not often do I escort outsiders.
    - Interact with the lantern besides my wagon to inform me you are prepared.
    emotions: 000000000500000000000000030000000100000000000000
  - pathName: Going to the Wilderness?
    paragraphs:
    - Are you adequately prepared for our foray? The fee is 50 <color=#E0D38F> Mints
      </color> <sprite index=0>. {freezePlayer}
    emotions: 04000000
  - pathName: Cannot go to Wilderness currently
    paragraphs:
    - The sun will be setting soon. Attend to other matters. {freezePlayer}
    emotions: 02000000
  - pathName: Have a Barricade
    paragraphs:
    - Welcome to my wagon. Here I sell the various goods and wares I compiled, in
      exhange for <color=#E0D38F> Mints</color> <sprite index=0>. {freezePlayer}
    - I will also purchase anything you wish to sell me. Anything that has worth,
      that is.
    - ...
    - Your estate. It will not last long without proper fortifications.
    - You are in luck. Today I recieved a surplus of units from the Craftsman.
    - Take these on the house. {givePlayerItems}
    - Consider it an investment.
    emotions: 01000000000000000600000003000000050000000200000000000000
  - pathName: Resell my barricades
    paragraphs:
    - ... {freezePlayer}
    - Does my advice ring on deaf ears?
    - Your ignorance knows no bounds. Do you not comprehend the importance of strong
      fortification?
    - Go on. Do what you will with these mints.
    emotions: 06000000040000000300000000000000
  - pathName: Go to my wagon
    paragraphs:
    - There you are. {freezePlayer}
    - I feared you got lost.
    - Go to my wagon. Beside the market square. We can discuss further down there.
    emotions: 030000000200000000000000
  - pathName: Text for shotgun
    paragraphs:
    - BlahBlahBlahShotgun {freezePlayer}
    - Boop. {givePlayerItems}
    emotions: 0300000002000000
  - pathName: Take Care of Pet
    paragraphs:
    - Done. You will find your new friend on your land. {itemBought}
    - if you want to gain it's trust, do not forget to take care of it.
    - The more it trusts you, the stronger it will become.
    emotions: 000000000000000005000000
  - pathName: No More pets
    paragraphs:
    - One is enough.
    emotions: 03000000
  - pathName: I am selling pets
    paragraphs:
    - You are just in time.
    - I recently got a hold of some unique specimens, but I have one too many.
    - I will cut you this very special limited time deal. Feel free to chose your
      favorite.
    - No refunds.
    emotions: 00000000020000000100000000000000
  - pathName: Critter needs a home
    paragraphs:
    - And where do you plan on housing this creature?
    - You will need to procure a suitable enclosure for this creature first.
    emotions: 0400000000000000
  fillerPaths:
  - pathName: I need your goods
    paragraphs:
    - Don't go dawdling on your farming duties.
    - Exported crops from VeilWood go for a hefty price. I don't need you to staunch
      my flow of riches.
    emotions: 0300000000000000
  - pathName: Allure Tip
    paragraphs:
    - You may have noticed by now that defending your farm becomes increasingly difficult
      when you have many crops growing at once.
    - Each plant you grow has its own "Allure" to it. Some attract more attention
      than others.
    - I believe that codex you tote around has some information pertaining to this
      subject.
    emotions: 050000000600000000000000
  - pathName: Torch Tip
    paragraphs:
    - Have you been making good use of your torch?
    - I always make sure to keep a steady fire near me. Keeps some of the creatures
      at bay.
    - If you notice some heavy smog above your fire, that is a good sign to attend
      to it. An idle flame is prone to being snuffed out.
    emotions: 040000000000000003000000
  - pathName: Buried Items Tip
    paragraphs:
    - You may have noticed some dirt being kicked up from a few spots on your farm.
    - This indicates some loose items underneathe the soil.
    - Try tilling the land to see what you can fine. I could always use some buried
      treasure.
    emotions: 000000000600000001000000
  - pathName: Barrel Tip
    paragraphs:
    - Do not underestimate the importance of having an abundance of water accessible
      on your estate.
    - Having a barrel or two could mean the difference between a thriving farm or
      one burnt to the ground.
    emotions: 0000000003000000
  - pathName: Pickled Tip
    paragraphs:
    - Pickled crops fetch a very high price.
    - You should consider making use of the Fermentation Vat.
    emotions: 0100000000000000
  questPaths: []
  itemRecievedPaths: []
  itemSpecificRemarks:
  - pathName: Scroll
    paragraphs:
    - Interesting.
    - I suppose they were never the best at tying up all their loose ends...
    emotions: 0000000002000000
  - pathName: Seeds
    paragraphs:
    - I believe farming is YOUR job.
    emotions: 03000000
  - pathName: Seeds 2
    paragraphs:
    - Your supposed to grow the seed before selling it.
    emotions: 03000000
  friendshipPath1: []
  friendshipPath2: []
  friendshipPath3: []
  alreadySpoken:
  - pathName: ...
    paragraphs:
    - '...

'
    emotions: 00000000
  branchingPaths:
  - pathName: No Carrots??
    paragraphs:
    - Hello again. Let us see how well your harvest fared.  {freezePlayer}
    - Really...? You couldn't grow a single one?
    - Here... Try again once more. This time consider planting fewer of them. The
      more you have growing, the more creatures will come. {givePlayerItems}
    - Do not botch this harvest. That young one over there looks like he is in dire
      need of it.
    - Perhaps this implement will also come in handy. Use those bullets sparingly.
    emotions: 0000000005000000030000000300000001000000
  - pathName: So Little Carrots
    paragraphs:
    - Hello again. Let us see how well your harvest fared.  {freezePlayer}
    - Hmm... I expected more. But this will do.
    - Normally I would advise anything you grow you bring to me. But that young boy
      over there looks peckish.
    - ... Oh, that reminds me. Here, I forgot to hand this to you yesterday. {givePlayerItems}
    - Be careful with the bullets. They are in short supply.
    emotions: 0000000002000000000000000000000003000000
  - pathName: Decent Carrots
    paragraphs:
    - Hello again. Let us see how well your harvest fared.  {freezePlayer}
    - You seem to have grown a majority of what you have sowed. These are good tidings
      indeed.
    - Normally I would advise anything you grow you bring to me. But that young boy
      over there looks peckish.
    - ... Oh, that reminds me. Here, I forgot to hand this to you yesterday. {givePlayerItems}
    - Be careful with the bullets. They are in short supply.
    emotions: 0000000001000000000000000000000003000000
  - pathName: Many Carrots
    paragraphs:
    - Hello again. Let us see how well your harvest fared.  {freezePlayer}
    - A perfect yield. Excellent work.
    - Normally I would advise anything you grow you bring to me. But that young boy
      over there looks peckish.
    - ... Oh, that reminds me. Here, I forgot to hand this to you yesterday. {givePlayerItems}
    - Be careful with the bullets. They are in short supply.
    emotions: 0000000001000000000000000000000003000000
  questCompletePaths:
  - pathName: Default Quest Complete
    paragraphs:
    - Thank you for completing my quest!
    emotions: 01000000
  dailyQuestPaths:
  - pathName: Daily Quest
    paragraphs:
    - Perfect timing! I was hoping you could help me out with something. {freezePlayer}
    emotions: 01000000
