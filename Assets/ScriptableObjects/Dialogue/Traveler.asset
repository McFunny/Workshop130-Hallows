%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0fd4c3c83fae23b4cae61c12ce438472, type: 3}
  m_Name: Traveler
  m_EditorClassIdentifier: 
  speakerName: Traveler
  defaultPath:
    pathName: Introduction
    paragraphs:
    - Hey...
    - I haven't seen you around here...
    - Guess we are both trapped in this hell hole.
    emotions: 000000000000000002000000
  questCompletePath:
    pathName: Thanks for completing quest
    paragraphs:
    - Thank you for completing my quest!
    emotions: 01000000
  repeatedItemPath:
    pathName: Again...?
    paragraphs:
    - Oh joy.... {itemName}.... Again....  {itemGiven}
    emotions: 03000000
  paths:
  - pathName: Buy something!
    paragraphs:
    - Anything looking appetizing?
    emotions: 00000000
  - pathName: Want to buy this?
    paragraphs:
    - Your taste buds have landed on the {storeItemName}. Its yours for {storeItemValue}
      <color=#E0D38F>Mints</color> <sprite index=0>!
    emotions: 00000000
  - pathName: Sold!
    paragraphs:
    - ...{itemBought}
    emotions: 01000000
  - pathName: No Money
    paragraphs:
    - You are gonna need some more money before you can have a bite of that
    emotions: 02000000
  - pathName: No Space
    paragraphs:
    - Your stomach, or perhaps inventory, seems to full to buy this
    emotions: 05000000
  fillerPaths:
  - pathName: I wonder if the outside is the same
    paragraphs:
    - My mind races. Is it like this everywhere?
    - Or is it just this foresaken cursed town...
    - The one that I just so happen to be stuck in.
    emotions: 040000000000000003000000
  - pathName: Just Passing Through
    paragraphs:
    - When I left my home to seek a new world, this is not what I was expecting.
    emotions: 00000000
  - pathName: Don't trust the cake
    paragraphs:
    - Take it from me when I say...
    - Don't eat the carrot cake...
    emotions: 0000000005000000
  - pathName: Barely remember
    paragraphs:
    - I can hardly remember the day that I first stepped into this tomb they call
      Veilwood.
    - It was so long ago... I can barely remember what the outside used to look like.
    emotions: 0000000002000000
  questPaths: []
  itemRecievedPaths:
  - pathName: Go Sell it instead
    paragraphs:
    - I don't have much use for something like that.
    - If you are looking to sell your stuff, I bet that weird wagon fellow will purchase
      it.
    emotions: 0200000000000000
  itemSpecificRemarks:
  - pathName: Go Sell it instead
    paragraphs:
    - What do you take me for, a charity?
    - I have need to spend my precious <color=#E0D38F> Mints</color> <sprite index=0>
      on your junk.
    emotions: 0200000000000000
  friendshipPath1: []
  friendshipPath2: []
  friendshipPath3: []
  alreadySpoken:
  - pathName: ...
    paragraphs:
    - '...

'
    emotions: 00000000
