  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0fd4c3c83fae23b4cae61c12ce438472, type: 3}
  m_Name: Traveler
  m_EditorClassIdentifier: 
  speakerName: Traveler
  defaultPath:
    pathName: Introduction
    paragraphs:
    - Hey...
    - I haven't seen you around here...
    emotions: 0000000000000000
  questCompletePath:
    pathName: Thanks for completing quest
    paragraphs:
    - Thank you for completing my quest!
    emotions: 06000000
  repeatedItemPath:
    pathName: Again...?
    paragraphs:
    - Oh joy.... {itemName}.... Again....  {itemGiven}
    emotions: 03000000
  paths:
  - pathName: Buy something!
    paragraphs:
    - Anything looking appetizing?
    emotions: 00000000
  - pathName: Want to buy this?
    paragraphs:
    - Your taste buds have landed on the {storeItemName}. Its yours for {storeItemValue}
      <color=#E0D38F>Mints</color> <sprite index=0>!
    emotions: 00000000
  - pathName: Sold!
    paragraphs:
    - ...{itemBought}
    emotions: 01000000
  - pathName: No Money
    paragraphs:
    - You are gonna need some more money before you can have a bite of that
    emotions: 02000000
  - pathName: No Space
    paragraphs:
    - Your stomach, or perhaps inventory, seems to full to buy this
    emotions: 05000000
  fillerPaths:
  - pathName: Lost Family
    paragraphs:
    - My family got lost in this mist...
    emotions: 02000000
  - pathName: Grown Up In VeilWood
    paragraphs:
    - I've grown up in VeilWood...
    - I can still see glimpses of my past...
    - I wish I could go back...
    emotions: 000000000000000002000000
  - pathName: Not Much To Do
    paragraphs:
    - There isn't much to do around here...
    - I want to go explore, but I know it's safer here...
    emotions: 0000000000000000
  questPaths: []
  itemRecievedPaths: []
  itemSpecificRemarks:
  - pathName: Go Sell it instead
    paragraphs:
    - What do you take me for, a charity?
    - I have need to spend my precious <color=#E0D38F> Mints</color> <sprite index=0>
      on your junk.
    emotions: 0200000000000000
  friendshipPath1: []
  friendshipPath2: []
  friendshipPath3: []
