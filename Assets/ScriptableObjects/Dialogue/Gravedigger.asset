MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0fd4c3c83fae23b4cae61c12ce438472, type: 3}
  m_Name: Gravedigger
  m_EditorClassIdentifier: 
  speakerName: Gravedigger
  defaultPath:
    pathName: Introduction
    paragraphs:
    - I can hear what happens on your farm at night
    - Hopefully I don't have to make a casket for you as well
    emotions: 0000000000000000
  questCompletePath:
    pathName: Thanks for completing quest
    paragraphs:
    - Thank you for completing my quest!
    emotions: 06000000
  repeatedItemPath:
    pathName: Again...?
    paragraphs:
    - Oh joy.... {itemName}.... Again....  {itemGiven}
    emotions: 03000000
  paths:
  - pathName: Buy something!
    paragraphs:
    - Anything looking appetizing?
    emotions: 00000000
  - pathName: Want to buy this?
    paragraphs:
    - Your taste buds have landed on the {storeItemName}. Its yours for {storeItemValue}
      <color=#E0D38F>Mints</color> <sprite index=0>!
    emotions: 00000000
  - pathName: Sold!
    paragraphs:
    - ...{itemBought}
    emotions: 01000000
  - pathName: No Money
    paragraphs:
    - You are gonna need some more money before you can have a bite of that
    emotions: 02000000
  - pathName: No Space
    paragraphs:
    - Your stomach, or perhaps inventory, seems to full to buy this
    emotions: 05000000
  fillerPaths:
  - pathName: Catacombs
    paragraphs:
    - That one entrance in the graveyard?
    - It has some kind of key
    - I don't know where it is
    emotions: 040000000000000000000000
  - pathName: Rascal
    paragraphs:
    - Have you seen that one kid?
    - I don't know where he came from
    - But I know my wife would have wanted to care for him
    - So that's what I'm doing
    emotions: 04000000000000000000000000000000
  - pathName: Joke
    paragraphs:
    - GraveDigger?
    - I hardly know her! Ha ha!
    - My wife is dead.
    emotions: 040000000100000006000000
  questPaths: []
  itemRecievedPaths: []
  itemSpecificRemarks:
  - pathName: Go Sell it instead
    paragraphs:
    - What do you take me for, a charity?
    - I have need to spend my precious <color=#E0D38F> Mints</color> <sprite index=0>
      on your junk.
    emotions: 0200000000000000
  friendshipPath1: []
  friendshipPath2: []
  friendshipPath3: []
